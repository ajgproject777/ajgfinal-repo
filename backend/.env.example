# DineGo Backend Environment Variables Template
# Copy this file to .env before starting the server

# Database connection URL (PostgreSQL asyncpg driver)
# When using Postgres.app: postgresql+asyncpg://<your_macos_username>@localhost:5432/dinego
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dinego

# Secret key for JWT signing (Minimum 32 characters; generate with: openssl rand -hex 32)
SECRET_KEY=change-this-insecure-key-to-a-random-32-byte-hex-string-before-running
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Environment mode: development | production | test
ENVIRONMENT=development

# Allowed CORS origins (comma-separated list)
# In development, includes local mobile/web dev servers. In production, set to exact domains.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://localhost:5173

# Server-Side Google Cloud API Key (Phase 2 - restricted by server IP, never exposed to clients)
GOOGLE_MAPS_SERVER_API_KEY=
