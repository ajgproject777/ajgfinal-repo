# ==============================================================================
# DineGo System Environment Variables Template
# Copy this file to .env for local workspace configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Customer Mobile Application (Expo / React Native)
# ------------------------------------------------------------------------------
# Backend API Base URL
# For iOS Simulator / Web: http://localhost:8000
# For Android Emulator:    http://10.0.2.2:8000
# For Physical Device:     http://<YOUR_LOCAL_IP>:8000 (e.g. http://192.168.1.50:8000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo Mode: true simulates mock responses; false queries the live FastAPI backend
EXPO_PUBLIC_DEMO_MODE=true

# Google Maps Mobile SDK (Phase 2 integration)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 2. Web Partner & Administration Dashboard (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Backend Service (FastAPI / SQLAlchemy / PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (AsyncPG driver required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dinego

# Cryptographic Secret Key for JWT token signing (minimum 32 characters)
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-insecure-key-to-a-random-32-byte-hex-string-before-running
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Environment Mode: development | production | test
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated list for local mobile/web dev servers)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://localhost:5173

# Server-Side Google Cloud API Key (Phase 2 route & places queries)
GOOGLE_MAPS_SERVER_API_KEY=
